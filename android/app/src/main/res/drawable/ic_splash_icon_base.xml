<?xml version="1.0" encoding="utf-8"?>
<!-- Same ring+dot brand mark as ic_launcher_foreground.xml, restructured so
     the SplashScreen API's animated-icon system can target the ring (via
     trimPathStart/End) and the dot (via a wrapping group's scale) — see
     ic_splash_icon_animated.xml and res/animator/splash_*.xml. Kept in its
     own file rather than reusing the launcher foreground directly since an
     adaptive-icon foreground can't carry trimPath/group-scale animation
     targets the way a plain vector can. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:name="ring"
        android:fillColor="#00000000"
        android:strokeColor="#F5F6F2"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:trimPathStart="0"
        android:trimPathEnd="0"
        android:pathData="M54,30 a24,24 0 1,1 -0.1,0 z" />
    <group
        android:name="dotGroup"
        android:pivotX="54"
        android:pivotY="48"
        android:scaleX="0"
        android:scaleY="0">
        <path
            android:fillColor="#F5F6F2"
            android:pathData="M54,48 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0" />
    </group>
</vector>
