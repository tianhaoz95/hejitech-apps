<?xml version="1.0" encoding="utf-8"?>
<!-- Draws the ring clockwise from nothing to a full circle, as if tracing
     out a completed hour-tracking progress ring — the same motif as the
     dashboard's threshold-progress rings, just played once at launch. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="trimPathEnd"
    android:valueFrom="0"
    android:valueTo="1"
    android:valueType="floatType"
    android:duration="650"
    android:interpolator="@android:interpolator/fast_out_slow_in" />
