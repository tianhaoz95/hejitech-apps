// Static assets only: `npm run build`, then `npx wrangler deploy`. No Worker script is needed yet;
// add `main` when the site grows server routes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wee-hours-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
