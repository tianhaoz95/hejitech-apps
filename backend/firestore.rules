rules_version = '2';

// MVP data model is deliberately nested under a single owner (no household/
// team sharing yet — that's fast-follow per reports/mvp-scope-v0.html
// Section 5.1), so ownership rules are just "you can only touch your own
// subtree." Revisit this file the day multi-participant logging ships; it
// will need per-property ACLs at that point, not a per-user root.
//
// Field-level validation below mirrors the Kotlin models by hand (no shared
// schema codegen at MVP scale — see android/core/.../model/Entry.kt and
// Property.kt, and backend/functions/src/schemas.ts for the AI-parsing
// subset). Known fields are type/range/size-checked; unknown extra fields
// are intentionally not rejected, so a client shipped slightly ahead of a
// rules deploy doesn't get locked out — this is a data-integrity net for a
// product whose whole premise is a trustworthy audit record, not a strict
// schema lock.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Custom claim set by backend/scripts/set-admin-claim.js (Admin SDK
    // only — never client-settable). Backs the admin/ site: read access to
    // other users' appFeedback/feedback, gated narrowly rather than opening
    // any broader cross-user access this MVP doesn't otherwise need.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // True whether `d[key]` is absent, explicitly null, or matches `type` —
    // the shape every nullable Kotlin field (Double?, Timestamp?) takes once
    // Firestore stores it (the SDK writes an explicit null, it doesn't drop
    // the key).
    function optionalType(d, key, type) {
      return !(key in d) || d[key] == null ||
        (type == 'number' && d[key] is number) ||
        (type == 'timestamp' && d[key] is timestamp) ||
        (type == 'string' && d[key] is string);
    }

    function isLatLng(d, latKey, lngKey) {
      return optionalType(d, latKey, 'number') && optionalType(d, lngKey, 'number') &&
        (!(latKey in d) || d[latKey] == null || (d[latKey] >= -90 && d[latKey] <= 90)) &&
        (!(lngKey in d) || d[lngKey] == null || (d[lngKey] >= -180 && d[lngKey] <= 180));
    }

    function isValidProperty(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200 &&
        d.createdAt is timestamp;
    }

    // A role tags who actually did the work on an entry (Property Manager,
    // Co-host, Cleaner, a contractor, ...) — the user's own hours are the
    // implicit default (entry has no roleId/roleName at all), so this
    // collection only ever holds *other* participants. Same shape/lifecycle
    // as isValidProperty above (a small user-managed roster, full CRUD).
    function isValidRole(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
        d.createdAt is timestamp;
    }

    // A category is either one of the app's fixed built-in values
    // (maintenance/turnover/guest_communication/supply_run/admin/other —
    // still mirrored in backend/functions/src/schemas.ts's EntrySchema for
    // AI parsing) or a free-form name from the user's own
    // `users/{uid}/categories` roster, added in place from Confirm/
    // EntryDetail the same way roles are — see isValidRole above, same
    // shape/lifecycle (small user-managed roster, full CRUD).
    function isValidCategory(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
        d.createdAt is timestamp;
    }

    // Per-ISO-week token usage counters (doc id = "GGGG-Www", e.g.
    // "2026-W33") — deviceTokenUsage is client-written (only the device
    // itself knows what it ran on-device), cloudTokenUsage is server-only
    // (see the match blocks below); same field shape either way.
    function isValidTokenUsage(d) {
      return d.inputTokens is int && d.inputTokens >= 0 &&
        d.outputTokens is int && d.outputTokens >= 0 &&
        d.requestCount is int && d.requestCount >= 0 &&
        d.weekStart is timestamp && d.updatedAt is timestamp;
    }

    function isValidEntry(d) {
      return d.propertyId is string && d.propertyId.size() <= 200 &&
        d.propertyName is string && d.propertyName.size() <= 200 &&
        d.task is string && d.task.size() <= 5000 &&
        d.durationMinutes is int && d.durationMinutes >= 0 && d.durationMinutes <= 1440 &&
        // No longer a fixed enum whitelist — a custom category name (see
        // isValidCategory above) is just as valid here as one of the
        // built-ins; this only guards against something absurd.
        d.category is string && d.category.size() > 0 && d.category.size() <= 100 &&
        d.status in ['pending_review', 'confirmed'] &&
        d.source in ['manual', 'voice', 'text', 'photo'] &&
        d.activityDate is timestamp &&
        d.loggedAt is timestamp &&
        optionalType(d, 'confirmedAt', 'timestamp') &&
        d.isVague is bool &&
        d.isBackfilled is bool &&
        d.daysLate is int && d.daysLate >= 0 && d.daysLate <= 3650 &&
        d.riskReasons is list && d.riskReasons.size() <= 20 &&
        d.photoUrls is list && d.photoUrls.size() <= 30 &&
        d.inProgress is bool &&
        // Absent on docs written before pause/resume shipped — same policy as rawTranscript below.
        (!('isPaused' in d) || d.isPaused is bool) &&
        optionalType(d, 'pausedAt', 'timestamp') &&
        (!('pausedDurationSeconds' in d) || (d.pausedDurationSeconds is int && d.pausedDurationSeconds >= 0 && d.pausedDurationSeconds <= 86400)) &&
        d.isTrip is bool &&
        d.mileageCaptureMethod is string && d.mileageCaptureMethod.size() <= 20 &&
        d.miles is number && d.miles >= 0 && d.miles <= 100000 &&
        optionalType(d, 'odometerStart', 'number') &&
        optionalType(d, 'odometerEnd', 'number') &&
        isLatLng(d, 'tripStartLat', 'tripStartLng') &&
        isLatLng(d, 'tripEndLat', 'tripEndLng') &&
        isLatLng(d, 'captureLat', 'captureLng') &&
        isLatLng(d, 'stopLat', 'stopLng') &&
        d.audioUrl is string && d.audioUrl.size() <= 2000 &&
        // Absent on docs written before this field existed — same
        // "unknown/missing extra fields don't get rejected" policy as
        // isValidAudioCapture's `language` field below.
        (!('rawTranscript' in d) || (d.rawTranscript is string && d.rawTranscript.size() <= 5000)) &&
        optionalType(d, 'stoppedAt', 'timestamp') &&
        // Absent (or null) means "me/owner" — see isValidRole above; only
        // present when this entry is logged under someone else's role.
        optionalType(d, 'roleId', 'string') &&
        (!('roleId' in d) || d.roleId == null || d.roleId.size() <= 200) &&
        optionalType(d, 'roleName', 'string') &&
        (!('roleName' in d) || d.roleName == null || d.roleName.size() <= 200);
    }

    function isValidCorrection(d) {
      return d.entryId is string && d.entryId.size() > 0 && d.entryId.size() <= 200 &&
        d.fieldName is string && d.fieldName.size() > 0 && d.fieldName.size() <= 100 &&
        d.aiValue is string && d.aiValue.size() <= 5000 &&
        d.finalValue is string && d.finalValue.size() <= 5000 &&
        d.recordedAt is timestamp;
    }

    // Generic (arbitrary file type) attachments — distinct from the
    // image-only `photoUrls` array still on the entry doc itself. One doc
    // per uploaded file, nested under its entry (unlike corrections, which
    // are a sibling collection with an entryId back-reference — attachments
    // are true entry-owned children, and there's no cross-entry query need
    // that would favor the sibling shape). `storagePath` is stored
    // explicitly (not derived from downloadURL) so delete/download can
    // build a StorageReference without parsing a signed URL. Immutable once
    // written — no update rule — since a changed file should be a new
    // attachment, not a silent overwrite of the audit trail.
    function isValidAttachment(d) {
      return d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 300 &&
        d.contentType is string && d.contentType.size() > 0 && d.contentType.size() <= 150 &&
        d.fileSize is number && d.fileSize > 0 && d.fileSize <= 104857600 &&
        d.storagePath is string && d.storagePath.size() > 0 && d.storagePath.size() <= 500 &&
        d.downloadURL is string && d.downloadURL.size() <= 2000 &&
        d.uploadedAt is timestamp &&
        d.note is string && d.note.size() <= 2000;
    }

    // A note is the one editable field on an otherwise-immutable attachment
    // doc (see the `attachments` match block below) — everything else must
    // stay byte-for-byte identical to what create() wrote, so this can't be
    // used to sneak in a changed storagePath/downloadURL pointing at
    // different file content under the same doc.
    function isValidNoteUpdate(before, after) {
      return after.fileName == before.fileName &&
        after.contentType == before.contentType &&
        after.fileSize == before.fileSize &&
        after.storagePath == before.storagePath &&
        after.downloadURL == before.downloadURL &&
        after.uploadedAt == before.uploadedAt &&
        after.note is string && after.note.size() <= 2000;
    }

    function isValidAudioCapture(d) {
      return d.storagePath is string && d.storagePath.size() > 0 && d.storagePath.size() <= 500 &&
        d.capturedAt is timestamp &&
        isLatLng(d, 'lat', 'lng') &&
        // Which Whisper checkpoint to transcribe this capture with — absent
        // on docs written before this field existed, which is fine, same
        // "unknown/missing extra fields don't get rejected" policy as
        // everywhere else in this file.
        (!('language' in d) || d.language in ['en', 'zh', 'auto']);
    }

    // Quick Capture's typed-text counterpart to isValidAudioCapture above —
    // same "immediate local save, background parse" shape, but since text
    // is small there's no Storage upload step and therefore no
    // storagePath; the raw text lives directly on this doc instead.
    function isValidTextCapture(d) {
      return d.rawText is string && d.rawText.size() > 0 && d.rawText.size() <= 5000 &&
        d.capturedAt is timestamp &&
        isLatLng(d, 'lat', 'lng');
    }

    // Optional single box the user drew on the screenshot to point at the
    // area of interest — absent entirely if they skipped boxing. Normalized
    // 0..1 fractions of image width/height, not pixels, so it stays valid
    // regardless of device screen resolution.
    function isValidFeedbackRegion(d) {
      return !('region' in d) || d.region == null || (
        d.region is map &&
        d.region.x is number && d.region.x >= 0 && d.region.x <= 1 &&
        d.region.y is number && d.region.y >= 0 && d.region.y <= 1 &&
        d.region.w is number && d.region.w >= 0 && d.region.w <= 1 &&
        d.region.h is number && d.region.h >= 0 && d.region.h <= 1
      );
    }

    // "Shake to report" feedback — in-app, from a signed-in owner, unlike
    // the anonymous login-free feedback/{feedbackId} collection above (that
    // one has no owner at all; this one is nested per-user like entries).
    // Client-writable on create only by the owner. Status transitions
    // (pending -> triaged/resolved) come from either the triage-feedback
    // skill's fetch script (Admin SDK, bypasses these rules entirely) or
    // the admin/ site (a real client, subject to isValidAdminStatusUpdate
    // below) — same append-only-from-the-owner posture as isValidCorrection
    // above, just with a narrow admin-only side door for triage bookkeeping.
    function isValidAppFeedback(d) {
      return d.description is string && d.description.size() <= 5000 &&
        d.screenshotPath is string && d.screenshotPath.size() > 0 && d.screenshotPath.size() <= 500 &&
        optionalType(d, 'downloadURL', 'string') &&
        isValidFeedbackRegion(d) &&
        d.appVersion is string && d.appVersion.size() <= 50 &&
        d.buildNumber is string && d.buildNumber.size() <= 50 &&
        d.osVersion is string && d.osVersion.size() <= 100 &&
        d.deviceModel is string && d.deviceModel.size() <= 100 &&
        d.screenName is string && d.screenName.size() <= 200 &&
        d.locale is string && d.locale.size() <= 50 &&
        d.status == 'pending' &&
        d.createdAt == request.time &&
        optionalType(d, 'triagedAt', 'timestamp') &&
        optionalType(d, 'resolvedAt', 'timestamp');
    }

    // Lets the admin/ site flip pending -> triaged/resolved without going
    // through the Admin SDK — only 'status'/'triagedAt'/'resolvedAt' may
    // change (diff().affectedKeys(), same idiom as isValidNoteUpdate's
    // append-only enforcement elsewhere in this file); every other field on
    // the report is immutable from the client, admin included.
    function isValidAdminStatusUpdate(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['status', 'triagedAt', 'resolvedAt']) &&
        (after.status == 'triaged' || after.status == 'resolved');
    }

    // No owner (submitted from the login-free feedback/ site) — server-set
    // createdAt (== request.time, not just `is timestamp`) so a submitter
    // can't backdate it, same idea as corrections' append-only rule below.
    function isValidFeedback(d) {
      return d.message is string && d.message.size() > 0 && d.message.size() <= 5000 &&
        optionalType(d, 'email', 'string') &&
        (!('email' in d) || d.email == null || d.email.size() <= 200) &&
        d.createdAt == request.time;
    }

    // Public/anonymous — see feedback/README.md and firebase.json's
    // "contempo-feedback" hosting site. Nobody but an admin can read
    // submissions back (not even the submitter, who left no owner to check
    // against anyway); review them via the admin/ site or Firestore console.
    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Stripe customer ID -> uid lookup, written only by createCheckoutSession
    // and read only by stripeWebhook (both via the Admin SDK, which bypasses
    // these rules) — no client ever needs this, so it's fully closed.
    match /stripeCustomers/{customerId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Synced only by the stripeWebhook Cloud Function (Admin SDK, bypasses
      // these rules) — never client-writable, or a user could grant
      // themselves Pro by editing their own doc. See backend/functions/src/billing.ts.
      match /billing/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /properties/{propertyId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidProperty(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /roles/{roleId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidRole(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidCategory(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // On-device LLM usage, incremented directly by the client that ran
      // the inference (see android/.../agent/AgentClient.kt and
      // ios/.../Agent/AgentClient.swift) — no server involved, so unlike
      // billing/cloudTokenUsage below this can't be server-only.
      match /deviceTokenUsage/{weekId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTokenUsage(request.resource.data);
        allow delete: if false;
      }

      // Cloud LLM usage — synced only by the askAgentFlow/parseEntryFlow
      // Cloud Functions (Admin SDK, bypasses these rules), same
      // server-authoritative posture as billing above: the client never
      // sees real token counts for its own cloud calls, so it has nothing
      // legitimate to write here.
      match /cloudTokenUsage/{weekId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /entries/{entryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidEntry(request.resource.data);
        allow delete: if isOwner(uid);

        match /attachments/{attachmentId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && isValidAttachment(request.resource.data);
          allow update: if isOwner(uid) && isValidNoteUpdate(resource.data, request.resource.data);
          allow delete: if isOwner(uid);
        }
      }

      // Append-only: a correction is training signal, not app state, and
      // should never be edited or deleted once written — now enforced here,
      // not just by client convention.
      match /corrections/{correctionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidCorrection(request.resource.data);
        allow update, delete: if false;
      }

      // Queue of audio recorded on a device that can't transcribe/parse it
      // itself (the watch) — see core/data/AudioCaptureQueue.kt.
      match /audioCaptures/{captureId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidAudioCapture(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Quick Capture's typed-text queue — see isValidTextCapture above and
      // audioCaptures' comment for the shared "immediate local save,
      // background parse" design this mirrors.
      match /textCaptures/{captureId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTextCapture(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Shake-to-report bug/improvement reports — see isValidAppFeedback
      // above. Append-only from the owner; an admin can additionally read
      // every user's reports (the whole point of the admin/ site's Feedback
      // tab) and flip status via isValidAdminStatusUpdate, same as the
      // triage-feedback skill's fetch script already does via the Admin SDK.
      match /appFeedback/{feedbackId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidAppFeedback(request.resource.data);
        allow update: if isAdmin() && isValidAdminStatusUpdate(resource.data, request.resource.data);
        allow delete: if false;
      }
    }
  }
}
