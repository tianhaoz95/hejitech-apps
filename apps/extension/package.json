{
  "name": "@icecap/extension",
  "displayName": "Icecap — Real Estate Investment Analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Analyze real estate deals directly on Redfin, Zillow, and Realtor.com",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:prod": "plasmo build --no-source-maps",
    "package": "plasmo package"
  },
  "dependencies": {
    "@icecap/math": "workspace:*",
    "@icecap/types": "workspace:*",
    "@icecap/ui": "workspace:*",
    "firebase": "^11.2.0",
    "lucide-react": "^0.468.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "^20.0.0",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.16",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "sidePanel",
      "tabs",
      "activeTab",
      "storage"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:9099 http://localhost:8080 http://localhost:5001 http://127.0.0.1:9099 http://127.0.0.1:8080 http://127.0.0.1:5001"
    }
  }
}
