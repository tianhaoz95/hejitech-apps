# Firebase Web Config (Plasmo Prefixed)
PLASMO_PUBLIC_FIREBASE_API_KEY=...
PLASMO_PUBLIC_FIREBASE_AUTH_DOMAIN=...
PLASMO_PUBLIC_FIREBASE_PROJECT_ID=...
PLASMO_PUBLIC_FIREBASE_STORAGE_BUCKET=...
PLASMO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
PLASMO_PUBLIC_FIREBASE_APP_ID=...

# Google OAuth client ID (Web type) from Google Cloud Console.
# Required for prod sign-in via chrome.identity.launchWebAuthFlow.
# Find it: Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
# Add authorized redirect URIs for both the Sideload ID and Web Store ID:
# https://cljkjphaofjfagcekpbnkonpepdcciba.chromiumapp.org/
# https://gbjiibgccfkpodffchmnokflclbnbfpl.chromiumapp.org/
PLASMO_PUBLIC_GOOGLE_CLIENT_ID=...

# Dev / Testing
PLASMO_PUBLIC_USE_EMULATOR=true
