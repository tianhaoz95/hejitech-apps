rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User profiles ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if true; // In prod: if request.auth != null && request.auth.uid == uid;

      // User's saved properties
      match /properties/{propertyId} {
        allow read, write: if true; // In prod: if request.auth != null && request.auth.uid == uid;
      }

      // User settings
      match /settings/{settingId} {
        allow read, write: if true; // In prod: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── Subscriptions ─────────────────────────────────────────────────────
    match /subscriptions/{uid} {
      allow read, write: if true; // In prod: read if auth; write only via Admin SDK (Functions)
    }

    // ─── Promo codes ───────────────────────────────────────────────────────
    match /promo_codes/{codeId} {
      allow read, write: if true; // In prod: read if auth; write if admin
    }

    match /promo_redemptions/{redemptionId} {
      allow read, write: if true; // In prod: read if owner; write only via Functions
    }

    // ─── Admin-only collections ────────────────────────────────────────────
    match /scraper_reports/{reportId} {
      allow read, write: if true;
    }

    match /system_health/{docId} {
      allow read, write: if true;
    }
  }
}
