rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User profiles ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // User's saved properties
      match /properties/{propertyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // User settings
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── Subscriptions ─────────────────────────────────────────────────────
    // Users can read their own subscription; only Cloud Functions write it
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // written only by Cloud Functions (admin SDK)
    }

    // ─── Promo codes (public read for validation, admin write) ─────────────
    match /promo_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /promo_redemptions/{redemptionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false; // written only by Cloud Functions
    }

    // ─── Admin-only collections ────────────────────────────────────────────
    match /scraper_reports/{reportId} {
      // Users can create reports; admins can read/write all
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /system_health/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false; // written only by Cloud Functions
    }
  }
}
