rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Extension sideload packages are publicly downloadable (no auth required).
    match /extension/download/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied until storage features are introduced.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
