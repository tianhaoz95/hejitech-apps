# Copy to .env.local (gitignored) and fill in with real values.
# Fetch via: npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project contempo-platform
#
# Deliberately prefixed VITE_ADMIN_FIREBASE_* rather than reusing web/'s
# VITE_FIREBASE_* names: Vite merges matching process.env vars into
# import.meta.env, and the GitHub Actions deploy-hosting job builds this
# site and web/ from the same shell env in the same step (see
# .github/workflows/firebase-deploy.yml) — same-named vars there would
# collide and one site would silently get the other's Firebase Web App
# config (different appId/measurementId; the rest happen to be identical
# project-level values, but the appId is what actually distinguishes the
# "Contempo Admin" app registration from "Contempo Web").
VITE_ADMIN_FIREBASE_API_KEY=
VITE_ADMIN_FIREBASE_AUTH_DOMAIN=
VITE_ADMIN_FIREBASE_PROJECT_ID=
VITE_ADMIN_FIREBASE_STORAGE_BUCKET=
VITE_ADMIN_FIREBASE_MESSAGING_SENDER_ID=
VITE_ADMIN_FIREBASE_APP_ID=
VITE_ADMIN_FIREBASE_MEASUREMENT_ID=

# OAuth Web Client ID backing Google Identity Services sign-in (see
# src/pages/SignInPage.tsx) — Firebase Console -> Authentication -> Sign-in
# method -> Google -> Web SDK configuration. Same value as Android's
# GOOGLE_WEB_CLIENT_ID in android/local.properties — one Web client shared
# across the whole project, not per-app. Not a secret (OAuth client IDs are
# public by design), just gitignored here for the same reason the Firebase
# config above is: per-environment values shouldn't require a code change.
VITE_ADMIN_GOOGLE_CLIENT_ID=

# Optional: force emulator on/off. Unset defaults to "true" in `vite dev`,
# "false" in a production build (see src/lib/firebase.ts).
# VITE_USE_FIREBASE_EMULATOR=
