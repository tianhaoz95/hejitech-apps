{
  "name": "waypack",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "projects/*/packages/*",
    "projects/*/services/*"
  ],
  "scripts": {
    "build": "npm run build:waypack",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:waypack": "npm run build -w @waypack/bundle-schema -w @waypack/trip-sdk -w @waypack/cli",
    "test:waypack": "npm test -w projects/waypack/packages -w projects/waypack/services --if-present",
    "typecheck:waypack": "npm run typecheck -w projects/waypack/packages -w projects/waypack/services --if-present",
    "docs:dev": "vitepress dev projects/waypack/docs",
    "docs:build": "vitepress build projects/waypack/docs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "feedbackkit-web": "^1.0.62"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
