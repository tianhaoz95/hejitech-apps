{
  "name": "waypack",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "projects/*/packages/*",
    "projects/*/services/*",
    "projects/*/apps/*"
  ],
  "scripts": {
    "build": "npm run build:waypack",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:waypack": "npm run build -w @waypack/bundle-schema -w @waypack/trip-sdk -w @waypack/cli",
    "test:waypack": "npm test -w projects/waypack/packages -w projects/waypack/services --if-present",
    "typecheck:waypack": "npm run typecheck -w projects/waypack/packages -w projects/waypack/services --if-present",
    "build:weehours": "npm run build -w @weehours/web -w @weehours/glasses",
    "test:weehours": "npm test -w projects/weehours/packages -w projects/weehours/apps -w projects/weehours/services --if-present",
    "typecheck:weehours": "npm run typecheck -w projects/weehours/packages -w projects/weehours/apps -w projects/weehours/services --if-present",
    "build:g2digest": "npm run build -w @g2digest/web -w @g2digest/glasses",
    "test:g2digest": "npm test -w projects/g2digest/packages -w projects/g2digest/services --if-present",
    "typecheck:g2digest": "npm run typecheck -w projects/g2digest/packages -w projects/g2digest/apps -w projects/g2digest/services --if-present",
    "build:headway": "npm run build -w @headway/web -w @headway/glasses",
    "test:headway": "npm test -w projects/headway/packages -w projects/headway/apps --if-present",
    "typecheck:headway": "npm run typecheck -w projects/headway/packages -w projects/headway/apps -w projects/headway/services --if-present",
    "build:fitloop": "npm run build -w @fitloop/web -w @fitloop/glasses",
    "test:fitloop": "npm test -w projects/fitloop/packages -w projects/fitloop/apps --if-present",
    "typecheck:fitloop": "npm run typecheck -w projects/fitloop/packages -w projects/fitloop/apps -w projects/fitloop/services --if-present",
    "build:tether": "npm run build -w @tether/web",
    "test:tether": "npm test -w projects/tether/packages -w projects/tether/services --if-present",
    "typecheck:tether": "npm run typecheck -w projects/tether/packages -w projects/tether/services --if-present",
    "build:polymath": "npm run build -w @polymath/core -w @polymath/web -w @polymath/desktop",
    "dev:desktop:polymath": "npm run dev:desktop -w @polymath/desktop",
    "test:polymath": "npm test -w projects/polymath/packages -w projects/polymath/services --if-present",
    "typecheck:polymath": "npm run typecheck -w projects/polymath/packages -w projects/polymath/services -w projects/polymath/apps --if-present",
    "pages:dev": "node scripts/pages_sync.mjs && vitepress dev pages",
    "pages:build": "node scripts/pages_sync.mjs && vitepress build pages"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "feedbackkit-web": "^1.0.62"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
