{
  "name": "icecap",
  "private": true,
  "version": "0.16.18",

  "description": "Icecap — Residential Real Estate Investment Analyzer (Monorepo)",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:apps": "turbo run dev --parallel",
    "dev:all": "./scripts/dev-all.sh",
    "dev:hub": "turbo run dev --filter=@icecap/hub",
    "dev:extension": "turbo run dev --filter=@icecap/extension",
    "dev:admin": "turbo run dev --filter=@icecap/admin",
    "dev:landing": "turbo run dev --filter=@icecap/landing",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@icecap/math",
    "test:e2e": "./scripts/run-e2e.sh",
    "emulator": "firebase emulators:start --project=demo-icecap --import=firebase/emulator-data --export-on-exit=firebase/emulator-data",
    "emulator:seed": "node scripts/seed-emulator.mjs",
    "deploy:all": "./scripts/deploy-all.sh",
    "admin:grant": "node scripts/make-admin.mjs",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "firebase-tools": "^15.15.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "firebase-admin": "^13.8.0"
  }
}
