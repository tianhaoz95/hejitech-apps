# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.
# Unified releases (every SDK, both Portals, the demo DMG, CLI, skills, web SDK, React Native,
# desktop) go through `scripts/cut_release.sh feedbackkit`; single-component releases
# (cli-v…, web-sdk-v…, …) through projects/feedbackkit/scripts/cut_release.sh X.Y.Z --cli etc.
# Every FeedbackKit tag carries the project prefix: feedbackkit-v1.2.3, feedbackkit-cli-v1.2.3, …

NAME="FeedbackKit"
TAG_PREFIX="feedbackkit-v"
# No LEGACY_TAG_PREFIX: releases up to v1.0.62 live in the archived tianhaoz95/feedback-kit repo,
# and "v" here belongs to Waypack's legacy tags.

# The packages take their version from the tag at publish time; the Flutter plugin's pubspec is
# the one manifest kept at the released version, so it's the version file.
VERSION_FILE="projects/feedbackkit/flutter/feedbackkit_flutter/pubspec.yaml"

# Must be green on the newest commit touching CI_PATHS (the SDK is what every release ships).
CI_WORKFLOW="feedbackkit-sdk-ci.yml"
CI_PATHS=(projects/feedbackkit/Sources projects/feedbackkit/Tests projects/feedbackkit/Package.swift .github/workflows/feedbackkit-sdk-ci.yml)

RELEASE_WORKFLOWS=(feedbackkit-testflight.yml feedbackkit-testflight-portal.yml feedbackkit-release-macos-demo.yml feedbackkit-release-portal-macos.yml feedbackkit-publish-cli.yml feedbackkit-publish-skills.yml feedbackkit-publish-web-sdk.yml feedbackkit-publish-react-native.yml feedbackkit-publish-desktop.yml)
REQUIRED_SECRETS=(APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD MAC_SIGNING_P12_BASE64 MAC_SIGNING_P12_PASSWORD FEEDBACKKIT_NPM_TOKEN FEEDBACKKIT_RELEASE_TOKEN)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
