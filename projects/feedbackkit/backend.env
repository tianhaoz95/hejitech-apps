# Which Supabase project FeedbackKit runs on (sourced as bash; scripts/check_isolation.mjs).
# FeedbackKit is a service of its own with paying-plan infrastructure (Stripe, plan limits), so it
# keeps its own Supabase project rather than the shared HEJI one: BACKEND=own. Its migrations,
# functions and config live in projects/feedbackkit/supabase/, not the repo root supabase/.
BACKEND=own
SUPABASE_REF=gpucoladcyvijefdjudf
SUPABASE_URL=https://gpucoladcyvijefdjudf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_crkqEdaacVS02etk6k16ag_ATIk-8Kn
# Its own project, so its own naming (the shared project's schema/bucket rules don't apply).
SCHEMA=public
BUCKET=feedback-screenshots

# Every SDK, the CLI and the docs default to the hosted endpoint, so the whole project may say so.
BACKEND_FILES=(
  "projects/feedbackkit/**"
)
