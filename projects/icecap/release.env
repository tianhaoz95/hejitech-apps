# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Icecap"
TAG_PREFIX="icecap-v"

# The Chrome extension's version (scripts/build.mjs writes it into manifest.json). The Worker (site,
# web app, API) deploys on push (Cloudflare Workers Builds), not on release. Versions restarted at
# 0.2.0 in the monorepo, above the 0.1.4 the Chrome Web Store already has.
VERSION_FILE="projects/icecap/apps/extension/package.json"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="icecap-ci.yml"
CI_PATHS=(projects/icecap supabase package.json package-lock.json .github/workflows/icecap-ci.yml)

# Started by the published release (filters on TAG_PREFIX): builds the extension and attaches
# icecap-extension-<version>.zip (upload it to the Chrome Web Store by hand) and the -sideload.zip.
RELEASE_WORKFLOWS=(icecap-extension-release.yml)
REQUIRED_SECRETS=()

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
