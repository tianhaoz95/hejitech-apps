{
  "name": "@icecap/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Icecap's web app + Worker: the home page and waitlist, the deal dashboard (/app/), admin (/admin/), privacy and terms, the promo studio, and the API (Pro, Stripe, waitlist, admin) on Cloudflare",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3008 --mode development",
    "dev:worker": "vite build --mode development && wrangler dev",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "vite build && wrangler deploy --env production",
    "upload-version": "vite build && wrangler versions upload --env production",
    "test": "vitest run test"
  },
  "dependencies": {
    "@icecap/ai": "0.1.0",
    "@icecap/client": "0.1.0",
    "@icecap/math": "0.1.0",
    "@icecap/theme": "0.1.0",
    "@icecap/types": "0.1.0",
    "@icecap/ui": "0.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
