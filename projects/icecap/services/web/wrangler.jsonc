// Icecap's site + API: Vite-built pages (./dist) plus a Worker for /api, /stripe and the React apps'
// deep links (src/worker). Deploy from the repo root with `npm run deploy -w @icecap/web` (Cloudflare
// Workers Builds runs the same). Local: `npm run dev:worker` serves both on 127.0.0.1:8800.
{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "icecap-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "PUBLIC_URL": "http://127.0.0.1:8800",
    "SUPABASE_URL": "http://127.0.0.1:55421",
    // The demo anon key every local `supabase start` ships with.
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
  },
  // Local secrets: .dev.vars (SUPABASE_SERVICE_ROLE_KEY, and STRIPE_* to try checkout with the sandbox).
  "dev": { "port": 8800, "ip": "127.0.0.1" },

  "env": {
    "production": {
      "name": "icecap",
      "workers_dev": true,
      "vars": {
        // scripts/stripe_pro.mjs icecap --live (shared HEJI Stripe account).
        "STRIPE_PRICE_ANNUAL": "price_1UcfQwJiNqYDPd3oAezCl1IL",
        "STRIPE_PRICE_LIFETIME": "price_1UcfQwJiNqYDPd3oQ9RUtRCz",
        "PUBLIC_URL": "https://icecap.hejitech.workers.dev",
        "SUPABASE_URL": "https://jitdzllkxfhlrxxvljhp.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8"
      }
      // Secrets: SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (wrangler secret put --env production).
    }
  }
}
