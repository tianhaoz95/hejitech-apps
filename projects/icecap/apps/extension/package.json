{
  "name": "@icecap/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Icecap's Chrome extension (MV3): deal math on Redfin, Zillow and Realtor.com listings, saved deals synced to the web app, on-device AI",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "dev": "node scripts/build.mjs --dev --watch",
    "package": "npm run typecheck && node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icecap/ai": "0.1.0",
    "@icecap/client": "0.1.0",
    "@icecap/math": "0.1.0",
    "@icecap/types": "0.1.0",
    "@icecap/ui": "0.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.2",
    "@icecap/theme": "0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.2"
  }
}
