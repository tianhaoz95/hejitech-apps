{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polymath",
  "version": "../package.json",
  "identifier": "com.hejitech.polymath",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Polymath",
        "width": 1400,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tianhaoz95/hejitech-apps/releases/download/polymath-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQTE0MDVERTUwQThEQ0UKUldUT2pRcmxYVUNoWDJtRk9xaU5Ndi92NG9rM01LZmFYWXBhVzEvN1Q3OU8zMnZwaHNuUmpGU3gK"
    }
  }
}
