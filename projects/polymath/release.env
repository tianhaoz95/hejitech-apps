# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Polymath"
TAG_PREFIX="polymath-v"

# package.json is the version of the desktop app and core libraries.
VERSION_FILE="projects/polymath/apps/desktop/package.json"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="polymath-ci.yml"
CI_PATHS=(projects/polymath supabase package.json package-lock.json tsconfig.base.json .github/workflows/polymath-ci.yml)

# Started by the published release: signed/notarized Tauri macOS app. The Worker (site, docs, MCP)
# deploys on push instead (Cloudflare Workers Builds).
RELEASE_WORKFLOWS=(polymath-mac-release.yml)
REQUIRED_SECRETS=(MAC_SIGNING_P12_BASE64 MAC_SIGNING_P12_PASSWORD ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 POLYMATH_TAURI_SIGNING_PRIVATE_KEY)

# Waypack owns the repo's "latest" release.
LATEST=false
