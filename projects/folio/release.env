# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Folio"
TAG_PREFIX="folio-v"

# Folio is web-only: the release version is the Worker's package version (also served as the MCP
# serverInfo.version once bumped there). The Worker deploys on push (Cloudflare Workers Builds);
# a release only tags and publishes notes.
VERSION_FILE="projects/folio/services/web/package.json"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="folio-ci.yml"
CI_PATHS=(projects/folio supabase package.json package-lock.json tsconfig.base.json .github/workflows/folio-ci.yml)

RELEASE_WORKFLOWS=()
REQUIRED_SECRETS=()

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
