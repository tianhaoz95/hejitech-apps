# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="ToddlerCam"
TAG_PREFIX="toddlercam-v"
# No LEGACY_TAG_PREFIX: the pre-monorepo tags (v1.2.1 … v1.2.3) stay in the archived
# tianhaoz95/toddler-cam repo, and "v" here belongs to Waypack's legacy tags. The first release from
# here: scripts/cut_release.sh toddlercam patch (1.2.3 → 1.2.4).

# XcodeGen project: MARKETING_VERSION is the iPhone app's, the watch app's and the complications'
# version. CI assigns build numbers (UTC timestamps, above the old repo's run numbers 1…5).
VERSION_FILE="projects/toddlercam/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="toddlercam-ci.yml"
CI_PATHS=(projects/toddlercam .github/workflows/toddlercam-ci.yml)

# Started by the published release (filters on TAG_PREFIX).
RELEASE_WORKFLOWS=(toddlercam-testflight.yml)
# The team-wide HEJI signing identities and App Store Connect key.
REQUIRED_SECRETS=(APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
