# ToddlerCam's backend (sourced as bash; scripts/check_isolation.mjs). ToddlerCam has none: the
# cameras, photos, sounds and the watch remote all run on the devices (WatchConnectivity), with no
# account and no data collection (Kids Category). BACKEND=none keeps it that way; if a feature ever
# needs one, it joins the shared project like any other (supabase/GRADUATION.md in reverse:
# BACKEND=shared, SCHEMA=toddlercam, BUCKET=toddlercam, BACKEND_FILES).
BACKEND=none
SUPABASE_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCHEMA=
BUCKET=

EXTERNAL_SUPABASE_HOSTS=()

BACKEND_FILES=()
