# Voxbrief's backend (sourced as bash; scripts/check_isolation.mjs). Voxbrief has none: transcription
# and cleanup run on the device, notes stay in the app's own storage. BACKEND=none keeps it that way
# until a feature needs one; then it joins the shared project like any other (supabase/GRADUATION.md
# in reverse: BACKEND=shared, SCHEMA=voxbrief, BUCKET=voxbrief, BACKEND_FILES).
BACKEND=none
SUPABASE_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCHEMA=
BUCKET=

# Other services' Supabase projects the code may call (not our backend): FeedbackKit's ingest API.
EXTERNAL_SUPABASE_HOSTS=(gpucoladcyvijefdjudf)

BACKEND_FILES=()
