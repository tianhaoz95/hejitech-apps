# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Voxbrief"
TAG_PREFIX="voxbrief-v"
# No LEGACY_TAG_PREFIX: Voxbrief's pre-monorepo releases (v1.0.0 … v1.26.3) stay in the archived
# tianhaoz95/voxbrief repo, and "v" here belongs to Waypack's legacy tags. The first release from
# here: scripts/cut_release.sh voxbrief patch (1.26.3 → 1.26.4).

# XcodeGen project: MARKETING_VERSION is every target's version (iOS, watch, widgets, keyboard,
# Mac). Before the monorepo it was a fixed "1.1" and only the tag carried the real version; now the
# app, TestFlight and the Mac DMG all say the same thing. CI assigns build numbers (UTC timestamps).
VERSION_FILE="projects/voxbrief/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="voxbrief-ci.yml"
CI_PATHS=(projects/voxbrief .github/workflows/voxbrief-ci.yml)

# Started by the published release (both filter on TAG_PREFIX).
RELEASE_WORKFLOWS=(voxbrief-testflight.yml voxbrief-mac-release.yml)
# The team-wide HEJI signing identities and App Store Connect key.
REQUIRED_SECRETS=(APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD MAC_SIGNING_P12_BASE64 MAC_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release; VoxbriefMac's update check looks for the newest
# voxbrief-v release instead (VoxbriefMac/Services/UpdateChecker.swift).
LATEST=false

# The in-app What's New (VoxbriefApp/Views/WhatsNewView.swift) must describe the release first:
# its currentVersion and newest entry are what users see after updating.
release_check() {
  local f=projects/voxbrief/VoxbriefApp/Views/WhatsNewView.swift
  grep -q "currentVersion = \"$1\"" "$f" && return 0
  echo "!! $f: WhatsNewView.currentVersion isn't \"$1\". Add the release's features and fixes to What's New" >&2
  echo "   (and Tests/UnitTests/WhatsNewViewTests.swift) before releasing: see projects/voxbrief/CLAUDE.md" >&2
  return 1
}
