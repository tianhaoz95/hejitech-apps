# Roarly's backend (sourced as bash; scripts/check_isolation.mjs). Roarly has none: listening,
# decisions, sounds, the small model and Pro (StoreKit 2) all run on the devices, with no account and
# no data collection. BACKEND=none keeps it that way; if a feature ever needs one, it joins the shared
# project like any other (supabase/GRADUATION.md in reverse).
BACKEND=none
SUPABASE_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCHEMA=
BUCKET=

EXTERNAL_SUPABASE_HOSTS=()

BACKEND_FILES=()
