# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Roarly"
TAG_PREFIX="roarly-v"

# XcodeGen project: MARKETING_VERSION of the iPhone app and the watch app. CI assigns build numbers
# (UTC timestamps).
VERSION_FILE="projects/roarly/apps/ios/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the workflow's
# `paths:` filter (it only runs when they change).
CI_WORKFLOW="roarly-ci.yml"
CI_PATHS=(projects/roarly .github/workflows/roarly-ci.yml)

# Started by the published release (filters on TAG_PREFIX): TestFlight.
RELEASE_WORKFLOWS=(roarly-testflight.yml)
# The team-wide HEJI signing identities and App Store Connect key.
REQUIRED_SECRETS=(ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false

# The in-app What's New (apps/ios/App/Sources/Views/WhatsNewView.swift) must describe the release.
release_check() {
  local f=projects/roarly/apps/ios/App/Sources/Views/WhatsNewView.swift
  grep -q "currentVersion = \"$1\"" "$f" && grep -q "version: \"$1\"" "$f" && return 0
  echo "!! $f: What's New doesn't describe $1 (currentVersion and a releases entry at the top)." >&2
  return 1
}
