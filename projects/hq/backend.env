# HQ's backend (sourced as bash; scripts/check_isolation.mjs). HQ uses no Supabase project: its own
# store is a Cloudflare D1 database bound to its Worker (projects/hq/services/web/wrangler.jsonc),
# so it never touches the shared project or any other project's data (docs/decisions.md D6).
BACKEND=none
SUPABASE_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCHEMA=
BUCKET=

EXTERNAL_SUPABASE_HOSTS=()

BACKEND_FILES=()
