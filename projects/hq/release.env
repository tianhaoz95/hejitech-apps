# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="HQ"
TAG_PREFIX="hq-v"

# XcodeGen project: MARKETING_VERSION of the iPhone app. CI assigns build numbers.
VERSION_FILE="projects/hq/apps/ios/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep in sync with hq-ci.yml's `paths:`.
CI_WORKFLOW="hq-ci.yml"
CI_PATHS=(projects/hq .hq supabase package.json package-lock.json tsconfig.base.json .github/workflows/hq-ci.yml)

# Started by the published release (filters on TAG_PREFIX): TestFlight (App Store Connect app
# "HQ: Repo Autopilot", 6832847373). The Worker (portal, API, MCP, scheduler) deploys on push
# through Cloudflare Workers Builds. hq-cli-release.yml publishes the `hq` command (@hejitech/hq,
# apps/cli) to npm and GitHub Packages with the release's version (stamped in CI; the version in
# apps/cli/package.json is only what a checkout prints).
RELEASE_WORKFLOWS=(hq-testflight.yml hq-cli-release.yml)
# The team-wide HEJI signing identities, then the two registry tokens for the `hq` command.
REQUIRED_SECRETS=(ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD HQ_NPM_TOKEN HQ_GH_PACKAGES_TOKEN)

LATEST=false

# The in-app What's New (apps/ios/App/Sources/WhatsNewView.swift) must describe the release first.
release_check() {
  local f=projects/hq/apps/ios/App/Sources/WhatsNewView.swift
  grep -q "currentVersion = \"$1\"" "$f" && grep -q "version: \"$1\"" "$f" && return 0
  echo "!! $f: What's New doesn't describe $1 (currentVersion and a releases entry at the top)." >&2
  return 1
}
