// HQ: the portal (Vite-built pages in ./dist) plus a Worker for /api, /mcp and its OAuth endpoints
// (src/worker), and an hourly cron that enqueues due scouts, the CEO and health checks in every
// workspace. Data and sign-in: the shared Supabase project (schema `hq`, bucket `hq`).
// Local: `supabase start` (repo root), then `npm run dev:worker -w @hq/web` on 127.0.0.1:8799.
// Deploy: projects/hq/docs/DEPLOY.md.
{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "hq-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*", "/api/*"]
  },
  "vars": {
    "PUBLIC_URL": "http://127.0.0.1:8799",
    "SUPABASE_URL": "http://127.0.0.1:55421",
    // The demo anon key every local `supabase start` ships with.
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
  },
  // Local secret: .dev.vars (SUPABASE_SERVICE_ROLE_KEY from `supabase status`).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "hq-oauth-local" }],
  "triggers": { "crons": ["7 * * * *"] },
  "dev": { "port": 8799, "ip": "127.0.0.1" },

  "env": {
    "production": {
      "name": "hq",
      "workers_dev": true,
      "vars": {
        "PUBLIC_URL": "https://hq.hejitech.workers.dev",
        "SUPABASE_URL": "https://jitdzllkxfhlrxxvljhp.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8"
      },
      // Secret (wrangler secret put SUPABASE_SERVICE_ROLE_KEY --env production).
      "kv_namespaces": [{ "binding": "OAUTH_KV" }],
      "triggers": { "crons": ["7 * * * *"] }
    }
  }
}
