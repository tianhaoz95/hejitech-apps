# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Meowtrix"
TAG_PREFIX="meowtrix-v"
# No LEGACY_TAG_PREFIX: Meowtrix's pre-monorepo releases (v1.0.0 … v1.34.1) stay in the archived
# tianhaoz95/meowtrix repo, and "v" here belongs to Waypack's legacy tags. The first release from
# here ships package.json's 1.34.2: scripts/cut_release.sh meowtrix.

# package.json is the version of everything: the server (shown in the app), the tarballs and the
# desktop apps (src-tauri/tauri*.conf.json read it). Bump it with cut_release.sh, not by hand.
VERSION_FILE="projects/meowtrix/package.json"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="meowtrix-ci.yml"
CI_PATHS=(projects/meowtrix .github/workflows/meowtrix-ci.yml)

# Started by the published release (both filter on TAG_PREFIX): server tarballs for macOS/Linux,
# and the signed, notarized desktop DMGs + Tauri updater. Both refresh the rolling meowtrix-latest
# release that installs and updaters read (scripts/publish-latest.sh).
RELEASE_WORKFLOWS=(meowtrix-release.yml meowtrix-mac-release.yml)
# The team-wide HEJI Developer ID identity and App Store Connect key (notarization), and
# Meowtrix's own Tauri updater key (its public half is baked into installed apps).
REQUIRED_SECRETS=(MAC_SIGNING_P12_BASE64 MAC_SIGNING_P12_PASSWORD ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 MEOWTRIX_TAURI_SIGNING_PRIVATE_KEY)

# Waypack owns the repo's "latest" release; Meowtrix's updaters read meowtrix-latest instead.
LATEST=false
