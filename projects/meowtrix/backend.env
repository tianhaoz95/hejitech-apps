# Meowtrix's backend (sourced as bash; scripts/check_isolation.mjs). Meowtrix has none: it is a
# self-hosted server (server.js) on the user's own machine, plus desktop shells. BACKEND=none keeps
# it that way until a feature needs one; then it joins the shared project like any other.
BACKEND=none
SUPABASE_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCHEMA=
BUCKET=

# Other services' Supabase projects the code may call (not our backend): FeedbackKit's ingest API.
EXTERNAL_SUPABASE_HOSTS=(gpucoladcyvijefdjudf)

BACKEND_FILES=()
