# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Waypack"
TAG_PREFIX="waypack-v"
# Tags from before the monorepo (v1.0.0 … v1.8.9): the next version counts up from them.
LEGACY_TAG_PREFIX="v"

# pubspec.yaml ("version: 1.2.3+4"; the +build is left to CI) or package.json ("version").
VERSION_FILE="projects/waypack/apps/mobile/pubspec.yaml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="waypack-ci.yml"
CI_PATHS=(projects/waypack supabase package.json package-lock.json tsconfig.base.json .github/workflows/waypack-ci.yml .github/actions)

# Started by the published release (each filters on TAG_PREFIX). The Worker + site deploy on the
# version-bump push instead (Cloudflare Workers Builds).
RELEASE_WORKFLOWS=(waypack-testflight.yml waypack-mac-release.yml)
REQUIRED_SECRETS=(ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD MAC_SIGNING_P12_BASE64 MAC_SIGNING_P12_PASSWORD)

# Mark the release as the repo's "latest". Exactly one project may: installed Waypack Mac apps
# read releases/latest/download/appcast.xml for updates and /download/mac redirects to
# releases/latest/download/Waypack.dmg, so another project becoming "latest" breaks both.
LATEST=true
