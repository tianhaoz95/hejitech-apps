# Which Supabase project Waypack runs on, and the only files that may say so (sourced as bash).
# scripts/check_isolation.mjs enforces it; graduating to an own project = edit these files plus the
# WAYPACK_* GitHub variables (supabase/GRADUATION.md).

# shared: the HEJI project in supabase/ (migrations live there). own: graduated; its schema and
# migrations then live in the project's own folder, not in supabase/.
BACKEND=shared
SUPABASE_REF=jitdzllkxfhlrxxvljhp
SUPABASE_URL=https://jitdzllkxfhlrxxvljhp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8
# Postgres schema and Storage bucket, both named after the project.
SCHEMA=waypack
BUCKET=waypack

# Other services' Supabase projects the code may call (not our backend): FeedbackKit's ingest API.
EXTERNAL_SUPABASE_HOSTS=(gpucoladcyvijefdjudf)

# The only files in the repo that may contain the ref, URL or publishable key above. The mobile
# and Mac release builds read them from GitHub variables WAYPACK_SUPABASE_URL,
# WAYPACK_SUPABASE_ANON_KEY and WAYPACK_API_URL.
BACKEND_FILES=(
  projects/waypack/backend.env
  projects/waypack/services/mcp/wrangler.jsonc
)
