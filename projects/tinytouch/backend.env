# TinyTouch's backend (sourced as bash; scripts/check_isolation.mjs). TinyTouch has none: the
# watch games, sounds and the iPhone remote all run on the devices (WatchConnectivity), with no
# account and no data collection (Kids Category). BACKEND=none keeps it that way; if a feature ever
# needs one, it joins the shared project like any other (supabase/GRADUATION.md in reverse:
# BACKEND=shared, SCHEMA=tinytouch, BUCKET=tinytouch, BACKEND_FILES).
BACKEND=none
SUPABASE_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCHEMA=
BUCKET=

# FeedbackKit's ingest API (parent-submitted feedback), not our backend.
EXTERNAL_SUPABASE_HOSTS=(gpucoladcyvijefdjudf)

BACKEND_FILES=()
