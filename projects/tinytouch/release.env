# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="TinyTouch"
TAG_PREFIX="tinytouch-v"
# No LEGACY_TAG_PREFIX: the old tianhaoz95/TinyTouch repo (archived) has no release tags; its CI
# uploaded on every push to main. "v" here belongs to Waypack's legacy tags. The first release from
# here: scripts/cut_release.sh tinytouch patch (1.5.0 → 1.5.1; App Store Connect had 1.5).

# No XcodeGen: tools/generate_project.py writes ToddlerPlay.xcodeproj and keeps the
# MARKETING_VERSION it finds there, which every target (iPhone, watch, widget) shares. CI assigns
# build numbers (UTC timestamps, above the old repo's run number + 10).
VERSION_FILE="projects/tinytouch/ToddlerPlay.xcodeproj/project.pbxproj"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="tinytouch-ci.yml"
CI_PATHS=(projects/tinytouch .github/workflows/tinytouch-ci.yml)

# Started by the published release (filters on TAG_PREFIX).
RELEASE_WORKFLOWS=(tinytouch-testflight.yml)
# The team-wide HEJI signing identities and App Store Connect key.
REQUIRED_SECRETS=(APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
