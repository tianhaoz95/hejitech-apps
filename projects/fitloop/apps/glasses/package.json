{
  "name": "@fitloop/glasses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The FitLoop Even Hub plugin (.ehpk): today's workouts and meals on the G2, R1 check-ins, rest timers, live heart rate, feedback for your agent, offline queue",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5178",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/pack.mjs",
    "simulator": "evenhub-simulator \"http://127.0.0.1:5178/?api=http://127.0.0.1:8794\""
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@fitloop/core": "0.1.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
