# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="FitLoop"
TAG_PREFIX="fitloop-v"

# XcodeGen project: MARKETING_VERSION of the iPhone and Watch apps. The Even Hub plugin ships under the same
# version (apps/glasses/scripts/pack.mjs stamps it into app.json). CI assigns build numbers (UTC
# timestamps).
VERSION_FILE="projects/fitloop/apps/ios/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="fitloop-ci.yml"
CI_PATHS=(projects/fitloop supabase package.json package-lock.json tsconfig.base.json .github/workflows/fitloop-ci.yml)

# Started by the published release (filters on TAG_PREFIX): TestFlight, and the glasses' Even Hub
# plugin (.ehpk attached to the release). The Worker (site, API, MCP) deploys on the
# version-bump push instead (Cloudflare Workers Builds).
RELEASE_WORKFLOWS=(fitloop-testflight.yml fitloop-glasses-release.yml)
# The team-wide HEJI signing identities. FITLOOP_FEEDBACKKIT_RELEASE_TOKEN is optional.
REQUIRED_SECRETS=(ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false

# The in-app What's New (apps/ios/App/Sources/WhatsNewView.swift) must describe the release first.
release_check() {
  local f=projects/fitloop/apps/ios/App/Sources/WhatsNewView.swift
  grep -q "currentVersion = \"$1\"" "$f" && grep -q "version: \"$1\"" "$f" && return 0
  echo "!! $f: What's New doesn't describe $1 (currentVersion and a releases entry at the top)." >&2
  return 1
}
