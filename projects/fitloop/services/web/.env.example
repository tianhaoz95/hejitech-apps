# Copy to .env.local to point a dev build somewhere else. Without these the web app talks to the
# local stack (`supabase start` from the repo root) and offers email sign-in for the seed account.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Any value turns on email/password sign-in (local seed account only; production is Google only).
VITE_EMAIL_SIGNIN=
