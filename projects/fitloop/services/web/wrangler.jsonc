// The FitLoop site: Vite-built pages (./dist) plus a Worker for /api, /mcp and its OAuth endpoints
// (src/worker). Deploy from the repo root with `npm run deploy -w @fitloop/web` (Cloudflare Workers
// Builds runs the same). Local: `npm run dev:worker` serves both on 127.0.0.1:8794.
{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "fitloop-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*", "/api/*"]
  },
  "vars": {
    "PUBLIC_URL": "http://127.0.0.1:8794",
    "SUPABASE_URL": "http://127.0.0.1:55421",
    // The demo anon key every local `supabase start` ships with.
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
    // The local App Review demo account (review.ts): review@example.com / fitloop-review-dev.
    "REVIEW_EMAIL": "review@example.com",
    "REVIEW_PASSWORD_SHA256": "5dadb16c6d38ff475f3c80fbbbd2932719d2403769d293a31ea4576c110c2bc0"
  },
  // Local secrets: .dev.vars (SUPABASE_SERVICE_ROLE_KEY; scripts/test-api.mjs expects the local demo key).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "fitloop-oauth-local" }],
  "dev": { "port": 8794, "ip": "127.0.0.1" },

  "env": {
    "production": {
      "name": "fitloop",
      "workers_dev": true,
      "vars": {
        "PUBLIC_URL": "https://fitloop.hejitech.workers.dev",
        "SUPABASE_URL": "https://jitdzllkxfhlrxxvljhp.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8",
        "APPLE_TEAM_ID": "68CTFST8W2"
      },
      // Secrets APPLE_SIWA_KEY_ID + APPLE_SIWA_PRIVATE_KEY (a Sign in with Apple key) let account deletion
      // revoke Apple tokens (src/worker/apple.ts).
      // Secrets (wrangler secret put --env production): SUPABASE_SERVICE_ROLE_KEY, and
      // REVIEW_EMAIL + REVIEW_PASSWORD_SHA256 (scripts/review_account.sh fitloop).
      "kv_namespaces": [{ "binding": "OAUTH_KV" }]
    }
  }
}
