{
  "name": "@headway/glasses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Headway Even Hub plugin (.ehpk): live Caltrain boards on the G2, R1 ring gestures, pairing, tracking, offline timetable",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/pack.mjs",
    "simulator": "evenhub-simulator \"http://127.0.0.1:5176/?api=http://127.0.0.1:8792\""
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@headway/core": "0.1.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
