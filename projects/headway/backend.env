# Which Supabase project Headway runs on, and the only files that may say so (sourced as bash).
# scripts/check_isolation.mjs enforces it; graduating to an own project = edit these files
# (supabase/GRADUATION.md).

# shared: the HEJI project in supabase/ (migrations live there). own: graduated.
BACKEND=shared
SUPABASE_REF=jitdzllkxfhlrxxvljhp
SUPABASE_URL=https://jitdzllkxfhlrxxvljhp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8
SCHEMA=headway
# Named after the project as the convention requires; Headway stores no files, so the bucket isn't created.
BUCKET=headway

# Other services' Supabase projects the code may call (not our backend): none.
EXTERNAL_SUPABASE_HOSTS=()

# The only files in the repo that may contain the ref, URL or publishable key above.
BACKEND_FILES=(
  projects/headway/backend.env
  projects/headway/services/web/.env.production
  projects/headway/services/web/wrangler.jsonc
  projects/headway/apps/ios/HeadwayKit/Sources/HeadwayKit/Backend.swift
  projects/headway/docs/DEPLOY.md
)
