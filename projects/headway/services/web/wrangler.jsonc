// The Headway site: Vite-built pages (./dist) plus a Worker for /api, /mcp and its OAuth endpoints,
// and an every-minute cron (Caltrain realtime + alerts) (src/worker). Deploy from the repo root with
// `npm run deploy -w @headway/web` (Cloudflare Workers Builds runs the same). Local: `npm run
// dev:worker` serves both on 127.0.0.1:8792 (`curl "http://127.0.0.1:8792/cdn-cgi/handler/scheduled"` runs the cron).
{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "headway-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // No invocation logs: they record each request's URL, and board requests can carry the rider's
  // location (?lat=&lon=), which the privacy policy promises is never stored or logged.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*", "/api/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PUBLIC_URL": "http://127.0.0.1:8792",
    "SUPABASE_URL": "http://127.0.0.1:55421",
    // The demo anon key every local `supabase start` ships with.
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
    "REALTIME_EVERY_MIN": "2",
    "APNS_TEAM_ID": "68CTFST8W2",
    "APNS_TOPIC": "com.hejitech.headway",
    // The local App Review demo account (review.ts): review@example.com / headway-review-dev.
    "REVIEW_EMAIL": "review@example.com",
    "REVIEW_PASSWORD_SHA256": "b4762f28c1e03047d1bea23150b65414548c9082057cccbd1acac5d0877ca170"
  },
  // Local secrets: .dev.vars (SUPABASE_SERVICE_ROLE_KEY; optional TRANSIT_511_API_KEY, APNS_KEY_ID, APNS_PRIVATE_KEY).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "headway-oauth-local" }],
  "dev": { "port": 8792, "ip": "127.0.0.1" },

  "env": {
    "production": {
      "name": "headway",
      "workers_dev": true,
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "PUBLIC_URL": "https://headway.hejitech.workers.dev",
        "SUPABASE_URL": "https://jitdzllkxfhlrxxvljhp.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8",
        "APPLE_TEAM_ID": "68CTFST8W2",
        "REALTIME_EVERY_MIN": "2",
        "APNS_TEAM_ID": "68CTFST8W2",
        "APNS_TOPIC": "com.hejitech.headway"
      },
      // Secrets APPLE_SIWA_KEY_ID + APPLE_SIWA_PRIVATE_KEY (a Sign in with Apple key) let account deletion
      // revoke Apple tokens (src/worker/apple.ts).
      // Secrets (wrangler secret put --env production): SUPABASE_SERVICE_ROLE_KEY, TRANSIT_511_API_KEY,
      // APNS_KEY_ID, APNS_PRIVATE_KEY, and REVIEW_EMAIL + REVIEW_PASSWORD_SHA256 (scripts/review_account.sh). Without the 511 key boards are timetable-only; without the
      // APNs key no alerts are pushed (docs/DEPLOY.md).
      "kv_namespaces": [{ "binding": "OAUTH_KV" }]
    }
  }
}
