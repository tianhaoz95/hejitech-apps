# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Headway"
TAG_PREFIX="headway-v"

# XcodeGen project: MARKETING_VERSION of the iPhone app. The Even Hub plugin ships under the same
# version (apps/glasses/scripts/pack.mjs stamps it into app.json). CI assigns build numbers (UTC
# timestamps).
VERSION_FILE="projects/headway/apps/ios/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="headway-ci.yml"
CI_PATHS=(projects/headway supabase package.json package-lock.json tsconfig.base.json .github/workflows/headway-ci.yml)

# Started by the published release (filters on TAG_PREFIX): TestFlight, the glasses' Even Hub
# plugin (.ehpk attached to the release) and the Android app to Google Play's internal testing track. The Worker (site, API, cron, MCP) deploys on the
# version-bump push instead (Cloudflare Workers Builds).
RELEASE_WORKFLOWS=(headway-testflight.yml headway-glasses-release.yml headway-play-internal.yml)
# The team-wide HEJI signing identities. HEADWAY_FEEDBACKKIT_RELEASE_TOKEN is optional.
REQUIRED_SECRETS=(ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD
  HEADWAY_ANDROID_KEYSTORE_BASE64 HEADWAY_ANDROID_KEYSTORE_PASSWORD HEADWAY_ANDROID_KEY_ALIAS PLAY_SERVICE_ACCOUNT_JSON)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false

# The in-app What's New of both phone apps (iOS WhatsNewView.swift, Android WhatsNew.kt) must describe the release first.
release_check() {
  local f=projects/headway/apps/ios/App/Sources/WhatsNewView.swift
  local a=projects/headway/apps/android/app/src/main/java/com/hejitech/headway/app/ui/screens/WhatsNew.kt
  if ! { grep -q "currentVersion = \"$1\"" "$f" && grep -q "version: \"$1\"" "$f"; }; then
    echo "!! $f: What's New doesn't describe $1 (currentVersion and a releases entry at the top)." >&2
    return 1
  fi
  # The Android app's notes go with every release too.
  grep -q "CURRENT_VERSION = \"$1\"" "$a" && grep -q "version = \"$1\"" "$a" && return 0
  echo "!! $a: What's New doesn't describe $1 (CURRENT_VERSION and a releases entry at the top)." >&2
  return 1
}
