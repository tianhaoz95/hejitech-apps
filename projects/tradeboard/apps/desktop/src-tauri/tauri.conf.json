{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tradeboard Executor",
  "version": "../../executor/package.json",
  "identifier": "com.hejitech.tradeboard.executor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1431",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tradeboard Executor",
        "width": 820,
        "height": 860,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "copyright": "© HEJI TECH LLC",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/tradeboard-executor.mjs": "tradeboard-executor.mjs",
      "resources/install.sh": "install.sh"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tianhaoz95/hejitech-apps/releases/download/tradeboard-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2OENCQkExN0QyMjk1MzMKUldRemxTSjlvYnVNNXY1OFRaKzROT1c0MW1oaDA1SGY0d0VtWC9UUnQrZHBQT1VPTUdLeFhmZ0cK"
    }
  }
}
