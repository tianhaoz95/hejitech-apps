// The Trading Plan Board: Vite-built portal pages (./dist) plus a Worker for /api, /mcp and its OAuth
// endpoints and a minute cron (src/worker). Deploy from the repo root with `npm run deploy -w
// @tradeboard/web` (Cloudflare Workers Builds runs the same). Local: `npm run dev:worker` serves both
// on 127.0.0.1:8798 (`curl "http://127.0.0.1:8798/cdn-cgi/handler/scheduled"` runs the cron).
{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "tradeboard-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs stay off: request URLs and bodies carry plan text the owner hasn't published.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*", "/api/*", "/plans/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PUBLIC_URL": "http://127.0.0.1:8798",
    "SUPABASE_URL": "http://127.0.0.1:55421",
    // The demo anon key every local `supabase start` ships with.
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
    // Local only (a dev key). Production sets TOTP_ENC_KEY as a secret.
    // The integration test makes hundreds of calls a minute; production keeps the default 60.
    "AGENT_RATE_PER_MIN": "400",
    "TOTP_ENC_KEY": "dHJhZGVib2FyZC1sb2NhbC1kZXYta2V5LTMyYnl0ZXM="
  },
  // Local secrets: .dev.vars (SUPABASE_SERVICE_ROLE_KEY; scripts/test-api.mjs writes the local demo key).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "tradeboard-oauth-local" }],
  "dev": { "port": 8798, "ip": "127.0.0.1" },

  "env": {
    "production": {
      "name": "tradeboard",
      "workers_dev": true,
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "PUBLIC_URL": "https://tradeboard.hejitech.workers.dev",
        "SUPABASE_URL": "https://jitdzllkxfhlrxxvljhp.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8"
      },
      // Secrets (wrangler secret put --env production): SUPABASE_SERVICE_ROLE_KEY, TOTP_ENC_KEY.
      "kv_namespaces": [{ "binding": "OAUTH_KV" }]
    }
  }
}
