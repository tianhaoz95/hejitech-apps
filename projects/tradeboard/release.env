# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Trading Plan Board"
TAG_PREFIX="tradeboard-v"

# The executor's version (bundled into dist/tradeboard-executor.mjs). The Worker (portal, Board MCP,
# executor API) deploys on push (Cloudflare Workers Builds), not on release.
VERSION_FILE="projects/tradeboard/apps/executor/package.json"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="tradeboard-ci.yml"
CI_PATHS=(projects/tradeboard supabase package.json package-lock.json .github/workflows/tradeboard-ci.yml)

# Started by the published release (filters on TAG_PREFIX): tests and bundles the executor and
# attaches tradeboard-executor.mjs, install.sh and policy.example.json to the release.
RELEASE_WORKFLOWS=(tradeboard-executor-release.yml)
REQUIRED_SECRETS=()

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
