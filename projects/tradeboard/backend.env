# Which Supabase project the Trading Plan Board runs on, and the only files that may say so (sourced
# as bash). scripts/check_isolation.mjs enforces it; graduating to an own project = edit these files
# (supabase/GRADUATION.md).

# shared: the HEJI project in supabase/ (migrations live there). own: graduated.
BACKEND=shared
SUPABASE_REF=jitdzllkxfhlrxxvljhp
SUPABASE_URL=https://jitdzllkxfhlrxxvljhp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8
SCHEMA=tradeboard
# Reserved name; no bucket is created (the board stores no files).
BUCKET=tradeboard

# Other services' Supabase projects the code may call (not our backend): none.
EXTERNAL_SUPABASE_HOSTS=()

# The only files in the repo that may contain the ref, URL or publishable key above.
BACKEND_FILES=(
  projects/tradeboard/backend.env
  projects/tradeboard/services/web/.env.production
  projects/tradeboard/services/web/wrangler.jsonc
  projects/tradeboard/docs/DEPLOY.md
)
