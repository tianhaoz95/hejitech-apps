<?xml version="1.0" encoding="utf-8"?>
<!-- The center dot pops in with a slight overshoot right as the ring
     finishes drawing (starts at 550ms, ring finishes at 650ms) — the small
     overlap and the overshoot bounce is what reads as "premium" rather than
     mechanical; a strict 0-then-1 handoff would look more like a loading
     spinner than a brand moment. Total animation stays under the platform's
     1000ms icon-animation ceiling (ends at 800ms). -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0"
        android:valueTo="1"
        android:valueType="floatType"
        android:startOffset="550"
        android:duration="250"
        android:interpolator="@android:interpolator/overshoot" />
    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0"
        android:valueTo="1"
        android:valueType="floatType"
        android:startOffset="550"
        android:duration="250"
        android:interpolator="@android:interpolator/overshoot" />
</set>
