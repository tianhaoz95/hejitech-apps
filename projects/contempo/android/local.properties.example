# Copy to local.properties (git-ignored). Android Studio fills in sdk.dir itself.
sdk.dir=/Users/<you>/Library/Android/sdk

# Optional: point a build at another Supabase project than the shared HEJI one
# (projects/contempo/backend.env), e.g. the local stack through adb reverse tcp:55421 tcp:55421:
# SUPABASE_URL=http://127.0.0.1:55421
# SUPABASE_PUBLISHABLE_KEY=<local anon key from `supabase status`>
