# Copy to .env.local (gitignored) and fill in with real values.
# Fetch via: npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project contempo-platform
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: force emulator on/off. Unset defaults to "true" in `vite dev`,
# "false" in a production build (see src/lib/firebase.ts).
# VITE_USE_FIREBASE_EMULATOR=
