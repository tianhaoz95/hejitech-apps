# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Contempo"
TAG_PREFIX="contempo-v"
# No LEGACY_TAG_PREFIX: the pre-monorepo TestFlight builds (3.0 build 86 and earlier) were uploaded
# by hand from the old repo, which has no release tags; "v" here belongs to Waypack.

# XcodeGen project: MARKETING_VERSION (shared by the app, widgets and watch app). CI assigns build
# numbers (UTC timestamps, above the old 1…86). Android ships separately (Play Console).
VERSION_FILE="projects/contempo/ios/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="contempo-ci.yml"
CI_PATHS=(projects/contempo supabase package.json package-lock.json .github/workflows/contempo-ci.yml)

# Started by the published release (filters on TAG_PREFIX). The Worker deploys on the version-bump
# push instead (Cloudflare Workers Builds) or by hand (npm run deploy -w @contempo/web).
RELEASE_WORKFLOWS=(contempo-testflight.yml)
# The team-wide HEJI signing identities Waypack and Wee Hours use too.
REQUIRED_SECRETS=(ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
