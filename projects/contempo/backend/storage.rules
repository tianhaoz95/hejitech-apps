rules_version = '2';

// Photo evidence attachments, one folder per user. Same "single owner"
// simplification as firestore.rules — see the note there.
//
// Both paths below split allow read (ownership only — a signed-in owner
// can always read their own evidence back, even if it somehow failed a
// write-time check, e.g. legacy files or a future intentional relaxation)
// from allow write (ownership PLUS content-type/size validation), rather
// than one combined "read, write" line — write is the side that actually
// needs hardening against a corrupted/malicious upload masquerading as
// evidence.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/entries/{entryId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 15 * 1024 * 1024;
    }

    // Generic (arbitrary type) attachments — see firestore.rules'
    // isValidAttachment for the Firestore doc these pair with. Kept under
    // its own `attachments/` segment rather than reusing the path above so
    // the original image-only/15MB photo-evidence rule can stay untouched.
    // Allowlist covers what EntryDetailScreen can actually view in-app
    // (image/video/pdf/text) plus common office document types a host might
    // attach as evidence; 100MB covers a phone-shot video without leaving
    // storage cost effectively uncapped.
    match /users/{uid}/entries/{entryId}/attachments/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 100 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('text/.*') ||
          request.resource.contentType in [
            'application/pdf',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            'application/vnd.openxmlformats-officedocument.presentationml.presentation',
            'application/vnd.ms-excel',
            'application/vnd.ms-powerpoint',
            'application/zip',
            'application/json'
          ]
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Raw audio uploaded straight from the recording device (watch or
    // phone) — entry-independent, since it's uploaded and queued before any
    // Entry exists yet. Kept permanently, never deleted. See
    // core/data/AudioCaptureQueue.kt. 50MB matches
    // AudioCaptureProcessor.MAX_AUDIO_BYTES (the read-side cap) so a
    // document this can't ever download couldn't have been written either.
    match /users/{uid}/audioCaptures/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.contentType.matches('audio/.*') &&
        request.resource.size < 50 * 1024 * 1024;
    }

    // Shake-to-report screenshots — same shape as the photo-evidence rule
    // above (image-only, 15MB cap), just under its own path so a feedback
    // screenshot is never mistaken for entry evidence. See
    // firestore.rules' isValidAppFeedback for the doc this pairs with.
    // Admin read (request.auth.token.admin == true, same custom claim as
    // firestore.rules' isAdmin()) backs the admin/ site's Feedback tab,
    // which needs to render another user's screenshot.
    match /users/{uid}/appFeedback/{feedbackId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 15 * 1024 * 1024;
    }
  }
}
