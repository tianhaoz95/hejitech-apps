{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  // Local: `npm run dev:worker` against the local Supabase stack (supabase start at the repo root).
  "name": "contempo-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "vars": {
    "PUBLIC_URL": "http://127.0.0.1:8789",
    "SUPABASE_URL": "http://127.0.0.1:55421",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
    // The local App Review demo account (src/worker/review.ts): review@example.com / contempo-review-dev.
    // Production: secrets REVIEW_EMAIL + REVIEW_PASSWORD_SHA256 (scripts/review_account.sh contempo).
    "REVIEW_EMAIL": "review@example.com",
    "REVIEW_PASSWORD_SHA256": "3198ddd08fe633e8714cea57d44dfec9b905a7449d46ff7281a64aad7213319a"
  },
  "dev": { "port": 8789, "ip": "127.0.0.1" },

  // Production: wrangler deploy --env production (Workers Builds on push to main). Secrets:
  // SUPABASE_SERVICE_ROLE_KEY (required); STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET (billing);
  // APPLE_SIWA_KEY_ID + APPLE_SIWA_PRIVATE_KEY (a Sign in with Apple key: deletion revokes Apple tokens, src/worker/apple.ts).
  "env": {
    "production": {
      "name": "contempo",
      "workers_dev": true,
      "vars": {
        "PUBLIC_URL": "https://contempo.hejitech.workers.dev",
        "SUPABASE_URL": "https://jitdzllkxfhlrxxvljhp.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8",
        "APPLE_TEAM_ID": "68CTFST8W2"
      }
    }
  }
}
