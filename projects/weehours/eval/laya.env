# The Laya model the app bundles (scripts/fetch-models.sh), downloads when not bundled
# (ModelManager.modelURL in apps/ios/App/Sources/Services.swift; ml's tests check they match)
# and the LLM eval scores. Changing it re-runs weehours-llm-eval.yml. See ml/README.md.
LAYA_REPO=tianhaoz95/wee-hours-baby-activity
LAYA_FILE=Laya-ft-Q8_0.gguf
# The run's tag: each app version downloads exactly the model it was released with, even after a
# newer run is published under the same file name.
LAYA_REVISION=groups2
