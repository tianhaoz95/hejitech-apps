# Copy to .env (git-ignored) or set in the Cloudflare build. Without them, `npm run dev` talks to
# the local stack (`supabase start`) and `npm run build` refuses to run unless WEB_ALLOW_LOCAL=1.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon or publishable key>
VITE_SUPPORT_EMAIL=support@<your-domain>
# App Store (or public TestFlight) link. Empty shows "Coming soon to the App Store".
VITE_APP_STORE_URL=
# Show the email + password form (the seeded dev accounts). Google and Apple are always shown.
VITE_EMAIL_SIGNIN=
