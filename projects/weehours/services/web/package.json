{
  "name": "@weehours/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wee Hours website + Worker: landing page, agent setup, account, OAuth consent, legal pages, and the MCP server with its OAuth endpoints (Cloudflare)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "dev:worker": "WEB_ALLOW_LOCAL=1 vite build && wrangler dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "vite build && wrangler deploy --env production",
    "upload-version": "vite build && wrangler versions upload --env production"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@supabase/supabase-js": "^2.118.0",
    "@weehours/core": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
