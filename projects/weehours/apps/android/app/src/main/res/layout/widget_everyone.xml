<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_everyone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1614"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_everyone_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Household"
        android:textColor="#FFD97D2E"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_everyone_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nothing logged yet"
        android:textColor="#FFF5ECE6"
        android:textSize="13sp" />
</LinearLayout>
