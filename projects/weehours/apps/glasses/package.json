{
  "name": "@weehours/glasses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Even Realities G2 + R1 ring app: gesture logging, voice capture relayed to the phone, one-line HUD status",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && evenhub pack app.json dist -o dist/app.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@weehours/core": "0.1.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
