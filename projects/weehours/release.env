# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="Wee Hours"
TAG_PREFIX="weehours-v"
# No LEGACY_TAG_PREFIX: Wee Hours' pre-monorepo releases (v0.1.0 … v0.1.2) stay in the archived
# tianhaoz95/wee-hours repo, and "v" here belongs to Waypack's legacy tags. The first release
# from here: scripts/cut_release.sh weehours patch (0.1.2 → 0.1.3).

# XcodeGen project: MARKETING_VERSION (shared by the app, widgets and watch app). CI assigns build
# numbers (UTC timestamps, as before the monorepo).
VERSION_FILE="projects/weehours/apps/ios/project.yml"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="weehours-ci.yml"
CI_PATHS=(projects/weehours supabase package.json package-lock.json tsconfig.base.json .github/workflows/weehours-ci.yml .github/actions)

# Started by the published release (filters on TAG_PREFIX). The site + MCP Worker deploys on the
# version-bump push instead (Cloudflare Workers Builds).
RELEASE_WORKFLOWS=(weehours-testflight.yml)
# The team-wide HEJI signing identities Waypack uses too. FEEDBACKKIT_RELEASE_TOKEN is optional
# (without it the upload still counts; fixes just aren't announced to reporters).
REQUIRED_SECRETS=(ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false
