# Which Supabase project G2 Digest runs on, and the only files that may say so (sourced as bash).
# scripts/check_isolation.mjs enforces it; graduating to an own project = edit these files
# (supabase/GRADUATION.md).

# shared: the HEJI project in supabase/ (migrations live there). own: graduated.
BACKEND=shared
SUPABASE_REF=jitdzllkxfhlrxxvljhp
SUPABASE_URL=https://jitdzllkxfhlrxxvljhp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lZSe_L4Wd0Sw01h25eixzQ_vLU7FPP8
SCHEMA=g2digest
