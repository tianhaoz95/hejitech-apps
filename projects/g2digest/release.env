# Release settings for scripts/cut_release.sh (sourced as bash). See the script's header.

NAME="G2 Digest"
TAG_PREFIX="g2digest-v"

# The Even Hub plugin's version (scripts/pack.mjs stamps it into app.json when packing). The Worker
# deploys on push (Cloudflare Workers Builds), not on release.
VERSION_FILE="projects/g2digest/apps/glasses/package.json"

# Must be green on the newest commit touching CI_PATHS. Keep CI_PATHS in sync with the
# workflow's `paths:` filter (it only runs when they change).
CI_WORKFLOW="g2digest-ci.yml"
CI_PATHS=(projects/g2digest supabase package.json package-lock.json .github/workflows/g2digest-ci.yml)

# Started by the published release (filters on TAG_PREFIX): packs the .ehpk onto the release, uploads
# it to Even Hub and promotes it to Beta (EVENHUB_EMAIL / EVENHUB_PASSWORD: the CLI login); uploads the
# iPhone app (same version, read from the plugin's package.json) to TestFlight (team-wide signing).
RELEASE_WORKFLOWS=(g2digest-plugin-release.yml g2digest-testflight.yml)
REQUIRED_SECRETS=(EVENHUB_EMAIL EVENHUB_PASSWORD ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64 SIGNING_P12_BASE64 SIGNING_P12_PASSWORD DEV_SIGNING_P12_BASE64 DEV_SIGNING_P12_PASSWORD)

# Waypack owns the repo's "latest" release (its Mac app updates from releases/latest).
LATEST=false

# The iPhone app's What's New (apps/ios/App/Sources/WhatsNewView.swift) must describe the release first.
release_check() {
  local f=projects/g2digest/apps/ios/App/Sources/WhatsNewView.swift
  grep -q "currentVersion = \"$1\"" "$f" && grep -q "version: \"$1\"" "$f" && return 0
  echo "!! $f: What's New doesn't describe $1 (currentVersion and a releases entry at the top)." >&2
  return 1
}
